# ─────────────────────────────────────────────────────────────────────
# PoshanLens — environment
#
# Copy to `.env.local` (git-ignored) and fill in your key.
# The app works WITHOUT any of this: with no key, every AI surface falls
# back to the deterministic rule-written text and the bundled catalogue.
# ─────────────────────────────────────────────────────────────────────

# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Server-side only. Do NOT prefix with NEXT_PUBLIC_, or it ships to the
# browser in the client bundle (spec §17).
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order — the first that responds wins,
# so a model that 404s in your region falls through to the next.
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
